<odoo>

    <record id="mail_template_approval_request" model="mail.template">
        <field name="name">Sale Order: Approval Request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Approval needed: Order {{ object.name }}</field>
        <field name="email_to">{{ object.user_id.email }}</field>
        <field name="body_html" type="html">
            <p>
                Order <strong t-out="object.name"/> for
                <strong t-out="object.partner_id.name"/> has a discount of
                <strong t-out="object.discount_percent"/>% and needs your
                approval before it can be confirmed.
            </p>
        </field>
    </record>

</odoo>
